{
  "name": "viaim-notebook-assistant",
  "productName": "OpeniFLYTEK",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node --experimental-sqlite server/server.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "electron": "electron .",
    "app": "npm run build && electron .",
    "app:build": "npm run build && node electron/package-mac.cjs",
    "app:open": "open \"dist_mac/OpeniFLYTEK.app\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "crypto-js": "^4.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "electron": "^44.7.2",
    "express": "^4.21.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "ws": "^8.18.0"
  }
}
